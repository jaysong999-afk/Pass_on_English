NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: run SQL migrations directly (npm run seed:e2e / apply:rls)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@passonenglish.com

# Cron (Tencent Lighthouse scheduler / external scheduler → /api/cron/*)
CRON_SECRET=change-me-in-production

# Administrator security rollout. Keep optional while both administrators enroll,
# then change to required and rebuild/restart the application.
ADMIN_MFA_MODE=optional
# Optional dedicated HMAC secret for pseudonymous security-event IP hashes.
# If omitted, CRON_SECRET is used. Generate a long random value in production.
ADMIN_SECURITY_EVENT_HMAC_KEY=
# Optional dedicated cookie-signing key; falls back to the audit HMAC key, then CRON_SECRET.
ADMIN_MFA_SESSION_SECRET=
ADMIN_MFA_MAX_AGE_DAYS=7

NEXT_PUBLIC_APP_URL=http://localhost:3000
BANK_ACCOUNT_KR=국민은행 123-456-789012 (예금주: Pass on English)
BANK_ACCOUNT_CN=中国银行 6222 0000 0000 0000 (户名: Pass on English)
